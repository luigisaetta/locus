# Locus notebook configuration. Copy to .env and edit.
#
# Locus defaults to the bundled mock model when no provider is set, so
# notebooks run end-to-end with no credentials. Set LOCUS_MODEL_PROVIDER
# (and the matching credentials) when you want a live model.

# Model provider: "mock" (default), "openai", or "anthropic".
# LOCUS_MODEL_PROVIDER=mock

# ─── Mock (offline, no credentials) ─────────────────────────────────
# Force the bundled mock model — useful in CI or air-gapped runs.
# LOCUS_MODEL_PROVIDER=mock

# ─── OpenAI ─────────────────────────────────────────────────────────
# LOCUS_MODEL_PROVIDER=openai
# LOCUS_MODEL_ID=gpt-4o
# OPENAI_API_KEY=sk-...

# ─── Anthropic ──────────────────────────────────────────────────────
# LOCUS_MODEL_PROVIDER=anthropic
# LOCUS_MODEL_ID=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Vendor integrations (examples/integrations/) ───────────────────
# Each is optional: set the credential to hit the live API, leave it
# unset to get a deterministic offline sample. See
# examples/integrations/README.md.

# Threat intel (VirusTotal-shaped) — IOC reputation/enrichment.
# VT_API_KEY=...

# SIEM (Splunk/Elastic-shaped) — log/alert search.
# SIEM_URL=https://siem.example.net
# SIEM_TOKEN=...

# GPU clouds — inference-fingerprint timing-probe dispatch.
# RUNPOD_API_KEY=...
# LAMBDA_API_KEY=...
# LAMBDA_REGION=us-east-1
# LAMBDA_PROBE_RESULT_URL=https://results.example.net/probe

# ─── OCI cloud-posture agent (notebook 81) ──────────────────────────
# The read-only SOC analyst drives the core describe_oci / use_oci tools
# as the ~/.oci/config profile below (the same LOCUS_OCI_* / OCI_* names the
# model harness reads). Point it at a read-only identity — a group whose
# policies grant only inspect / read verbs; use_oci refuses any mutating
# operation regardless. Leave unset to run notebook 81 offline (Part 1 is
# deterministic, Part 2 prints a bring-your-own-credentials note).
# LOCUS_OCI_PROFILE=<your-profile>
# LOCUS_OCI_AUTH_TYPE=api_key      # or security_token
