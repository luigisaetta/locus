# Copy to .env and source it before booting services.
# Defaults to MockModel — no creds needed to run the demo.

# Provider: mock | openai | anthropic
LOCUS_MODEL_PROVIDER=mock

# OpenAI (when LOCUS_MODEL_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# LOCUS_MODEL_ID=gpt-4o

# Anthropic (when LOCUS_MODEL_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# LOCUS_MODEL_ID=claude-sonnet-4-6

# Service ports (defaults shown)
PORT_INTEL=8001
PORT_TRIAGE=8002
